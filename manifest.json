{
  "manifest_version": 3,
  "name": "Beesly Desk - UYAP Asistanı",
  "version": "1.4.2",
  "description": "UYAP asistanı: Tebligat sorgulama (PTT, UETS), E-Duruşma takip penceresi, EYP görüntüleyici, WhatsApp UDF düzeltici",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite",
    "storage",
    "contextMenus",
    "alarms",
    "downloads",
    "webRequest",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "commands": {
    "beesly-query-selection": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "Seçili barkodu Beesly ile sorgula"
    },
    "beesly-durusma-panel": {
      "suggested_key": { "default": "Ctrl+Shift+E" },
      "description": "Duruşma takip panelini yan panelde aç"
    }
  },
  "host_permissions": [
    "https://*.uyap.gov.tr/*",
    "https://uyap.gov.tr/*",
    "https://www.ptt.gov.tr/*",
    "https://api.ptt.gov.tr/*",
    "https://ptt.etebligat.gov.tr/*",
    "https://api.etebligat.gov.tr/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ptt.gov.tr/*"],
      "js": ["content-ptt-view.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ptt.etebligat.gov.tr/*"],
      "js": ["content-uets.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.uyap.gov.tr/*", "*://uyap.gov.tr/*"],
      "js": ["content-uyap.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://avukat.uyap.gov.tr/*"],
      "js": ["content-durusma.js"],
      "css": ["edurusma.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-whatsapp-udf.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://avukat.uyap.gov.tr/*", "https://*.uyap.gov.tr/*", "https://uyap.gov.tr/*"],
      "js": ["eyp-inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://avukat.uyap.gov.tr/*", "https://*.uyap.gov.tr/*", "https://uyap.gov.tr/*"],
      "js": ["eyp-jszip.min.js", "eyp-parser.js", "eyp-content.js"],
      "css": ["eyp-viewer.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["eyp-jszip.min.js", "eyp-parser.js", "eyp-viewer.js", "eyp-viewer.html"],
      "matches": ["https://avukat.uyap.gov.tr/*", "https://*.uyap.gov.tr/*", "https://uyap.gov.tr/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Beesly Desk'i Aç",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "side_panel": {
    "default_path": "edurusma-sidepanel.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "uyap-frame", "enabled": true, "path": "durusma-frame-rules.json" }
    ]
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}