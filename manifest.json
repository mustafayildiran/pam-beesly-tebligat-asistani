{
  "manifest_version": 3,
  "name": "Beesly Desk - Tebligat AsistanÄ±",
  "version": "1.1.2",
  "description": "Tebligat barkodlarını tek tıkla sorgulayan UYAP asistanı: PTT, UETS, EYP",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "clipboardWrite",
    "storage",
    "contextMenus",
    "alarms",
    "downloads",
    "webRequest"
  ],
  "commands": {
    "beesly-query-selection": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "SeÃ§ili barkodu Beesly ile sorgula"
    }
  },
  "host_permissions": [
    "https://*.uyap.gov.tr/*",
    "https://www.ptt.gov.tr/*",
    "https://api.ptt.gov.tr/*",
    "https://ptt.etebligat.gov.tr/*",
    "https://api.etebligat.gov.tr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ptt.gov.tr/*"],
      "js": ["content-ptt-view.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ptt.etebligat.gov.tr/*"],
      "js": ["content-uets.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.uyap.gov.tr/*"],
      "js": ["content-uyap.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://avukat.uyap.gov.tr/*", "https://*.uyap.gov.tr/*"],
      "js": ["eyp-inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://avukat.uyap.gov.tr/*", "https://*.uyap.gov.tr/*"],
      "js": ["eyp-jszip.min.js", "eyp-parser.js", "eyp-content.js"],
      "css": ["eyp-viewer.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["eyp-jszip.min.js", "eyp-parser.js", "eyp-viewer.js", "eyp-viewer.html"],
      "matches": ["https://avukat.uyap.gov.tr/*", "https://*.uyap.gov.tr/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Beesly Desk'i AÃ§",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}


